# ShopFlow configuration: copy to .env and adapt
# cp .env.example .env

# Elasticsearch
ES_HOST=http://elasticsearch:9200

# MongoDB
MONGO_URI=mongodb://mongodb:27017
MONGO_DB=shopflow

# Redis
REDIS_URL=redis://redis:6379/0

# Web application
APP_PORT=8000
FLASK_SECRET_KEY=change-me-with-a-long-random-string
SESSION_TTL_SECONDS=1800

# Alerting (module G)
ALERT_COOLDOWN_SECONDS=1800
ALERT_CHECK_INTERVAL_SECONDS=60
